>     ^^^^^^^^: 0   (TyNumberLiteral)

const unary0_2 = -0;
>     ^^^^^^^^: -0   (TyNumberLiteral)

const unary0_3 = ~0;
>     ^^^^^^^^: number   (TyNumber)

