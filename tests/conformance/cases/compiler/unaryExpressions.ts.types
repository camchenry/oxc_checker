>     ^^^^^^^^^^^^: 99999999999   (TyNumberLiteral)

const unaryLarge_2 = -99999999999;
>     ^^^^^^^^^^^^: -99999999999   (TyNumberLiteral)

const unaryLarge_3 = ~99999999999;
