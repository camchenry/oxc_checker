>     ^^^^^^^^: 2   (TyNumberLiteral)

const unary2_2 = -2;
>     ^^^^^^^^: -2   (TyNumberLiteral)

const unary2_3 = ~2;
>     ^^^^^^^^: number   (TyNumber)

