>     ^^^^^^^^: 1   (TyNumberLiteral)

const unary1_2 = -1;
>     ^^^^^^^^: -1   (TyNumberLiteral)

const unary1_3 = ~1;
>     ^^^^^^^^: number   (TyNumber)

