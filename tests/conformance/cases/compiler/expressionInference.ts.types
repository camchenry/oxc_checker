const x1 = 5;
>     ^^: 5   (NumberLiteral) (Identifier)

const x2 = 1 + 2;
>     ^^: number   (Number) (Identifier)

const x3 = "";
>     ^^: ""   (StringLiteral) (Identifier)

const x4 = "foo" + "bar";
>     ^^: string   (String) (Identifier)

const x5 = 1 + "";
>     ^^: string   (String) (Identifier)

const x6 = "" + 1;
>     ^^: string   (String) (Identifier)

const x7 = -5;
>     ^^: -5   (NumberLiteral) (Identifier)

const x8 = false;
>     ^^: false   (BooleanLiteral) (Identifier)
