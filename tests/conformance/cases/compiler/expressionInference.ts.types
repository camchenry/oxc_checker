const x1 = 5;
>     ^^-: 5 (TyLiteral)

const x2 = 1 + 2;
>     ^^-: number (TyNumber)

const x3 = "";
>     ^^-: "" (TyLiteral)

const x4 = "foo" + "bar";
>     ^^-: string (TyString)

const x5 = 1 + "";
>     ^^-: string (TyString)

const x6 = "" + 1;
>     ^^-: string (TyString)

const x7 = -5;
>     ^^-: -5 (TyLiteral)

const x8 = false;
>     ^^-: false (TyLiteral)
