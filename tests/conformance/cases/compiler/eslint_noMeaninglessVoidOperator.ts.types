void (() => {})();
>^^^^^^^^^^^^^^^^^^: undefined   (TyUndefined)

function foo() {}
>        ^^^: () => void   (TyFunction)

void foo();
>^^^^^^^^^^^: undefined   (TyUndefined)

void foo();
>    ^^^: () => void   (TyFunction)

(() => {})();
>^^^^^^^^^^^^^: void   (TyVoid)

function foo() {}
>        ^^^: () => void   (TyFunction)

foo(); // nothing to discard
>^^^: () => void   (TyFunction)

foo(); // nothing to discard
>^^^^^^: void   (TyVoid)

function bar(x: number) {
>        ^^^: (x: number) => number   (TyFunction)

function bar(x: number) {
>            ^: number   (TyNumber)

  void x; // discarding a number
> ^^^^^^^: undefined   (TyUndefined)

  void x; // discarding a number
>      ^: number   (TyNumber)

void bar(1); // discarding a number
>^^^^^^^^^^^^: undefined   (TyUndefined)

void bar(1); // discarding a number
>    ^^^: (x: number) => number   (TyFunction)
