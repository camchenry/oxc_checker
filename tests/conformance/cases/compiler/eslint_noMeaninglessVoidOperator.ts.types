>^^^^^^^^^^^^^^^^^^: undefined   (Undefined) (ExpressionStatement)

function foo() {}
>        ^^^: () => void   (Function) (Identifier)

void foo();
>^^^^^^^^^^^: undefined   (Undefined) (ExpressionStatement)

