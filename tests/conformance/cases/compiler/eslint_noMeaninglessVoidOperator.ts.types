>    ^^^: () => void   (Function) (Identifier)

(() => {})();
>^^^^^^^^^^^^^: void   (Void) (ExpressionStatement)

function foo() {}
>        ^^^: () => void   (Function) (Identifier)

foo(); // nothing to discard
>^^^: () => void   (Function) (Identifier)

foo(); // nothing to discard
>^^^^^^: void   (Void) (ExpressionStatement)

function bar(x: number) {
>        ^^^: (x: number) => number   (Function) (Identifier)

function bar(x: number) {
>            ^: number   (Number) (Identifier)

  void x; // discarding a number
> ^^^^^^^: undefined   (Undefined) (ExpressionStatement)

  void x; // discarding a number
>      ^: number   (Number) (Identifier)

void bar(1); // discarding a number
