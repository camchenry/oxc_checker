let count: number = 1;
>   ^^^^^: number   (TyNumber)

let label: string = "ready";
>   ^^^^^: string   (TyString)

let big: bigint = 1n;
>   ^^^: bigint   (TyBigint)

let _null: null = null;
>   ^^^^^: null   (TyNull)

let _undefined: undefined;
>   ^^^^^^^^^^: undefined   (TyUndefined)

let _unknown: unknown;
>   ^^^^^^^^: unknown   (TyUnknown)

let _any: any;
>   ^^^^: any   (TyAny)

let count2 = 1;
>   ^^^^^^: number   (TyNumber)

let label2 = "ready";
>   ^^^^^^: string   (TyString)

let big2 = 1n
>   ^^^^: bigint   (TyBigint)

let _null2 = null
>   ^^^^^^: null   (TyNull)

let _undefined2 = undefined;
>   ^^^^^^^^^^^: undefined   (TyUndefined)

let _undefined2 = undefined;
>                 ^^^^^^^^^: undefined   (TyUndefined)

let template = `Hello`
>   ^^^^^^^^: any   (TyAny)
