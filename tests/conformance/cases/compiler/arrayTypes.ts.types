const a1: number[] = [1, 2, 3];
>     ^^: number[]   (TyArray)

const a2 = [1, 2, 3];
>     ^^: number[]   (TyArray)

const a3 = [];
>     ^^: any[]   (TyArray)

const a4 = [null];
>     ^^: null[]   (TyArray)

const a5 = [undefined];
>     ^^: undefined[]   (TyArray)

const a6 = [""];
>     ^^: string[]   (TyArray)

const a7 = ["test", "foo"];
>     ^^: string[]   (TyArray)

const a8 = [1, [2]];
>     ^^: number[]   (TyArray)

const a9 = [1, ["foo", [{ bar: 1 }]]]
>     ^^: number[]   (TyArray)

const a9 = [1, ["foo", [{ bar: 1 }]]]
>                         ^^^: number   (TyNumber)
