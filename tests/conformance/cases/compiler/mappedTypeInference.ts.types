const objectValue = unwrap({ value: 1, name: "ready" });
>     ^^^^^^^^^^^: { value: number; name: string; }   (TyObject)

const objectValue = unwrap({ value: 1, name: "ready" });
>                   ^^^^^^: <T>(value: { [P in keyof T]: T[P]; }) => T   (TyFunction)

const objectValue = unwrap({ value: 1, name: "ready" });
>                            ^^^^^: number   (TyNumber)

const objectValue = unwrap({ value: 1, name: "ready" });
>                                      ^^^^: string   (TyString)

const arrayValue = unwrap([1, 2] as number[]);
>     ^^^^^^^^^^: number[]   (TyArray)

const arrayValue = unwrap([1, 2] as number[]);
>                  ^^^^^^: <T>(value: { [P in keyof T]: T[P]; }) => T   (TyFunction)

const tupleValue = unwrap([1, "ready"] as [number, string]);
