type ErrorTuple = [kind: "error", message: string];
>    ^^^^^^^^^^: ["error", string]   (TyTuple) (TSTypeAliasDeclaration)
       expected: [kind: "error", message: string]

type TupleEvent = MessageTuple | ErrorTuple;
