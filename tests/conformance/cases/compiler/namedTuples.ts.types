>     ^^^^^^^^^^: OptionalPoint   (TyTypeReference) (BindingIdentifier)

const pointWithX: OptionalPoint = [10];
>                 ^^^^^^^^^^^^^: any   (TyAny) (TSTypeReference)

const pointWithY: OptionalPoint = [10, 20];
>     ^^^^^^^^^^: OptionalPoint   (TyTypeReference) (BindingIdentifier)

const pointWithY: OptionalPoint = [10, 20];
>                 ^^^^^^^^^^^^^: any   (TyAny) (TSTypeReference)

type Command = [name: string, ...args: string[]];
