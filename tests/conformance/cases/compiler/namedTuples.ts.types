type TupleEvent = MessageTuple | ErrorTuple;
>                 ^^^^^^^^^^^^: any   (TyAny) (TSTypeReference)

type TupleEvent = MessageTuple | ErrorTuple;
>                                ^^^^^^^^^^: any   (TyAny) (TSTypeReference)

